# ==============================================================================
# ローカル開発環境用 設定ファイル (.env)
# ==============================================================================

# 各自のPCに接続したUSBデバイスのパスを指定してください
#
# 記入例:
# - Linux (一般的なUSBシリアル):   /dev/ttyUSB0, /dev/ttyUSB1
# - Linux (Arduino等):            /dev/ttyACM0
# - Windows (WSL2にアタッチ時):    /dev/ttyUSB0
#
HOST_MICRO_ROS_PORT=/dev/ttyACM0

# RPLIDAR C1(sllidar_ros2)のUSBデバイスパス
HOST_LIDAR_PORT=/dev/ttyUSB0

# 0は未設定時のROS 2デフォルト値でもあるため、同じLAN上に他のROS 2ノード・他のdiegobot機体が
# いる場合は衝突を避けるため機体ごとに別の値にすること。
ROS_DOMAIN_ID=0

# (参考) もしプログラム側でシリアルの通信速度（ボーレート）なども変えたい場合
# APP_BAUDRATE=115200
