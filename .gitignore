.venv/
venv/

__pycache__/
*.pyc
*.pyo
*.pyd

.DS_Store
Thumbs.db

build/
dist/
*.egg-info/

# ROS2/colcon build artifacts (e.g. edge/workspace/{install,log}/)
install/
log/
*.log
compile_commands.json

.*/
!.github/

.coverage
htmlcov/

# lcov/genhtml coverage output, generated by the "ROS2: Run Coverage" /
# "ROS2: Generate Coverage Report (Current Test Package)" tasks in edge/workspace/.vscode/tasks.json
edge/workspace/coverage/

*.swp

# Core dumps from crashes such as the Gazebo GUI (written to the cwd, depending on core_pattern)
core
core.*

tmp/
data/

.env

data/*
runs/*
doc/**/*.bkp

# Documents generated under edge/workspace/
edge/workspace/**/*.pdf
edge/workspace/**/*.gv

# Third-party sources fetched with vcstool. Their origin and version are tracked
# in edge/workspace/vendor.repos instead of committing the sources.
edge/workspace/src/vendor/

# Compose override generated by the Makefile from the video devices present at the time.
edge/docker/docker-compose.camera-devices.generated.yml

# Results of soak tests and chaos experiments, generated locally on each run
testing/soak_test/reports/*
!testing/soak_test/reports/.gitkeep
testing/eval-reports/

# Editor and dev container settings needed for development
!.devcontainer
!edge/workspace/.vscode/
!edge/esp32/.vscode/
!edge/pico/.vscode/

# Third-party mesh with no redistribution terms (see amr_description/meshes/README.md for how to get it)
edge/workspace/src/amr_description/meshes/camera_NUWA_HP60C.stl
