<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- 車輪とアームの関節の制御インターフェースを定義 -->
    <xacro:macro name="wheel_position_joint" params="name">
      <joint name="${name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_position_joint name="wheel_left_joint"/>
    <xacro:wheel_position_joint name="wheel_right_joint"/>
    <xacro:macro name="arm_position_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:arm_position_joint name="shoulder_pan"/>
    <xacro:arm_position_joint name="shoulder_lift"/>
    <xacro:arm_position_joint name="elbow_flex"/>
    <xacro:arm_position_joint name="wrist_flex"/>
    <xacro:arm_position_joint name="wrist_roll"/>
    <xacro:arm_position_joint name="gripper"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find amr_bringup)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
