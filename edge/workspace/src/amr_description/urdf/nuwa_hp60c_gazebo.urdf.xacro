<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <!-- 実機はRGB 640x480に深度を位置合わせして使うため、その状態の画角(H64.4°×V51.7°)と測距範囲(0.2〜4m)に合わせる -->
  <!-- https://www.yahboom.net/study/hp60c -->
  <gazebo reference="${namespace}hp60c_link">
    <sensor name="hp60c" type="rgbd_camera">
      <!-- 既定のフレーム名はGazebo内のスコープ付き名になり、TFに存在しない。 -->
      <gz_frame_id>${namespace}camera_camera_link_0</gz_frame_id>
      <camera>
        <horizontal_fov>1.124</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.2</near>
          <far>4.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
    </sensor>
  </gazebo>

</robot>
