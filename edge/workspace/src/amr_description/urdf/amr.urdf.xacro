<?xml version="1.0"?>
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="namespace" default=""/>
    <xacro:property name="namespace" value="$(arg namespace)"/>

    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="chassis_base.urdf.xacro" />
    <xacro:include filename="so101_new_calib.urdf.xacro" />
    <xacro:include filename="nuwa_hp60c.urdf.xacro" />
    <xacro:include filename="head_camera.urdf.xacro" />

    <xacro:arg name="use_gazebo" default="true"/>
    <xacro:if value="$(arg use_gazebo)">
        <xacro:include filename="nuwa_hp60c_gazebo.urdf.xacro" />
        <xacro:include filename="t_mini_plus_12_gazebo.urdf.xacro" />
        <xacro:t_mini_plus_12_gazebo name="${namespace}lidar_front_right"/>
        <xacro:t_mini_plus_12_gazebo name="${namespace}lidar_rear_left"/>
        <xacro:include filename="ros2_control.urdf" />
    </xacro:if>

    <!-- 実機のSO-101をros2_controlで動かす時だけtrueにする(use_gazeboはfalseにすること)。 -->
    <xacro:arg name="use_real_arm" default="false"/>
    <xacro:if value="$(arg use_real_arm)">
        <xacro:include filename="so101_feetech.ros2_control.xacro" />
    </xacro:if>

    <joint name="${namespace}arm_mount_joint" type="fixed">
        <origin xyz="-0.047 0.0705 ${chassis_top_z}" rpy="0 0 0"/>
        <parent link="${namespace}base_link"/>
        <child link="${namespace}arm_mount_link"/>
    </joint>

    <!-- 台座のSTLは上面がy=0で下が+y、前が+zの向きで書き出されているため、車体の向きに回して台座の中心を原点に置く。 -->
    <xacro:property name="arm_mount_mesh_xyz" value="-0.0275 0 0.0099"/>
    <xacro:property name="arm_mount_mesh_rpy" value="${-pi / 2} 0 ${-pi / 2}"/>
    <link name="${namespace}arm_mount_link">
        <visual>
            <origin xyz="${arm_mount_mesh_xyz}" rpy="${arm_mount_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://amr_description/meshes/arm_mount.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="dark"/>
        </visual>
        <collision>
            <origin xyz="${arm_mount_mesh_xyz}" rpy="${arm_mount_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://amr_description/meshes/arm_mount.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <!-- SO101のarm_base_linkは原点が台座底面より2.4mm上にあるため、台座の厚み(9.9mm)に足す。 -->
    <joint name="${namespace}arm_base_joint" type="fixed">
        <origin xyz="-0.021 0 0.01" rpy="0 0 0"/>
        <parent link="${namespace}arm_mount_link"/>
        <child link="${namespace}arm_base_link"/>
    </joint>

    <!-- 土台が少し傾いて付いているため、傾きと高さは頭部カメラの深度で見た床がTF上の床に重なるよう合わせた値 -->
    <joint name="${namespace}head_mount_joint" type="fixed">
        <origin xyz="-0.047 -0.0705 ${chassis_top_z - 0.001}" rpy="${radians(-0.93)} ${radians(-0.25)} 0"/>
        <parent link="${namespace}base_link"/>
        <child link="${namespace}head_base_link"/>
    </joint>
</robot>
