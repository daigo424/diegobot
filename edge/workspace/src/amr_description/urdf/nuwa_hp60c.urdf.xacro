<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <!-- カメラマウントの取付位置と姿勢 -->
  <xacro:property name="camera_mount_xyz" value="-0.003 0.045 -0.045"/>
  <xacro:property name="camera_mount_rpy" value="${radians(-88.81)} ${radians(-0.51)} ${radians(91.03)}"/>

  <!-- マウントに対するカメラの位置と姿勢はCADの\とおり。ただしUSBケーブルが当たらないよう、2つのネジ穴の中点を軸に上下逆さに付けている(画像はnuwa_hp60c.launch.pyで回して戻す)。 -->
  <xacro:property name="camera_xyz" value="-0.0009 -0.0051 0.0177"/>
  <xacro:property name="camera_rpy" value="${radians(-90.91)} ${radians(0.07)} ${radians(114.88)}"/>
  <!-- 深度で見た床がTF上の床と重なるよう、画像を出すフレームだけをずらす補正。見た目(マウント・本体)はCADのまま置く -->
  <xacro:property name="camera_calib_xyz" value="-0.0109 0.0022 -0.0043"/>
  <xacro:property name="camera_calib_rpy" value="${radians(-5.1)} ${radians(4.73)} ${radians(1.45)}"/>
  <!-- STLは腕に付く部分が少し傾いた座標で書き出されているため、腕に付く部分が上の取付位置に来るよう戻す。 -->
  <xacro:property name="camera_mount_mesh_xyz" value="0 0.0008 0"/>
  <xacro:property name="camera_mount_mesh_rpy" value="${radians(2.17)} 0 0"/>

  <joint name="${namespace}arm_camera_mount_joint" type="fixed">
    <origin xyz="${camera_mount_xyz}" rpy="${camera_mount_rpy}"/>
    <parent link="${namespace}gripper_link"/>
    <child link="${namespace}arm_camera_mount_link"/>
  </joint>

  <link name="${namespace}arm_camera_mount_link">
    <visual>
      <origin xyz="${camera_mount_mesh_xyz}" rpy="${camera_mount_mesh_rpy}"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/arm_camera_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="${camera_mount_mesh_xyz}" rpy="${camera_mount_mesh_rpy}"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/arm_camera_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="hp60c_joint" type="fixed">
    <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
    <parent link="${namespace}arm_camera_mount_link"/>
    <child link="${namespace}hp60c_link"/>
  </joint>

  <link name="${namespace}hp60c_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/camera_NUWA_HP60C.stl" scale="0.0001 0.0001 0.0001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="-0.0105 -0.0023 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.029 0.090 0.019"/>
      </geometry>
    </collision>
  </link>

  <joint name="${namespace}hp60c_calib_joint" type="fixed">
    <origin xyz="${camera_calib_xyz}" rpy="${camera_calib_rpy}"/>
    <parent link="${namespace}hp60c_link"/>
    <child link="${namespace}hp60c_calib_link"/>
  </joint>
  <link name="${namespace}hp60c_calib_link"/>

  <!-- ドライバ(ascamera)は画像・点群をこのフレームの子(camera_color_0等)としてTFを出すため、名前を合わせる。
       名前はノードの名前空間とカメラ番号から決まる(名前空間camera、0番)。光学座標系(Z=奥行き,X=右,Y=下)。 -->
  <joint name="${namespace}hp60c_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="${namespace}hp60c_calib_link"/>
    <child link="${namespace}camera_camera_link_0"/>
  </joint>
  <link name="${namespace}camera_camera_link_0"/>

  <!-- カメラを上下逆さにした向き。シミュレーターのカメラはここに付け、実機の画像を回して戻したものと同じ向きで出す。 -->
  <joint name="${namespace}hp60c_upright_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${pi} 0 0"/>
    <parent link="${namespace}hp60c_calib_link"/>
    <child link="${namespace}hp60c_upright_link"/>
  </joint>
  <link name="${namespace}hp60c_upright_link"/>

  <joint name="${namespace}hp60c_upright_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
    <parent link="${namespace}camera_camera_link_0"/>
    <child link="${namespace}camera_camera_link_0_upright"/>
  </joint>
  <link name="${namespace}camera_camera_link_0_upright"/>

</robot>
