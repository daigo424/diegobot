<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 実機の既定の6Hzでは測距4000Hzから1周約666点(0.54°刻み)、測距範囲は0.05〜12m -->
  <xacro:macro name="t_mini_plus_12_gazebo" params="name">
    <gazebo reference="${name}_scan">
      <sensor name="${name}" type="gpu_lidar">
        <!-- 既定のフレーム名はGazebo内のスコープ付き名になり、TFに存在しない。 -->
        <gz_frame_id>${name}_scan</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>666</samples>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
          </range>
        </lidar>
        <always_on>1</always_on>
        <update_rate>6</update_rate>
        <visualize>true</visualize>
        <topic>${name}/scan</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
