# つかむ対象。object_finderの文字指定に渡すため英語の短い名詞句にする。見え方でYOLOEの確信度が
# 大きく変わるため、言い換えを並べるとどれかで見つかりやすい(例: ["block", "cube", "box"])。
string[] queries
# 色で絞り込む(DetectedObjectのcolorと同じ名前)。空なら色を問わない。
string color
# 名前で指定された物(ユーザーの言葉のまま)。空でなければ色で絞らない。
string target_name
# 近づく動作が見分けて測った対象(odom基準)。あれば、今の検出のうちこの位置に一番近い物をつかむ。
# 無ければ(frame_idが空なら)、target_nameをその場で見分ける。
DetectedObject target_object
---
uint8 SUCCESS=0
uint8 NOT_FOUND=1
uint8 OUT_OF_REACH=2
uint8 PLANNING_FAILED=3
uint8 EXECUTION_FAILED=4
uint8 GRASP_FAILED=5
uint8 CANCELED=6
uint8 error_code
string message
# 対象にした物体。OUT_OF_REACHのときは、近づく側がこの位置を使う。
DetectedObject object
---
# 今の段階(looking, finding, opening, approaching, grasping, lifting, retreating)
string stage
