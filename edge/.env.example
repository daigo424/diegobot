# ==============================================================================
# ローカル開発環境用 設定ファイル (.env)
# ==============================================================================

# マイコン(micro-ROS)のUSBシリアルポート。/dev/ttyUSB*等の番号は抜き差しの順序で入れ替わるため、
# USBチップ名・シリアル番号で決まる/dev/serial/by-id/配下のパスを指定する(`ls -l /dev/serial/by-id/`で確認)。
# 例: ESP32(CH340) /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
#     Pico         /dev/serial/by-id/usb-Raspberry_Pi_Pico_<シリアル番号>-if00
HOST_MICRO_ROS_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0

# YDLIDAR T-mini Plus(右前・左後)のUSBシリアルポート。付属のUSB変換基板(CP2102)はどれもシリアル番号が同じで
# /dev/serial/by-id/では2台を区別できないため、挿したUSBポートの位置で決まる/dev/serial/by-path/配下のパスを指定する
# (`ls -l /dev/serial/by-path/`で確認)。挿すポートを入れ替えると左右が入れ替わる。
HOST_LIDAR_FRONT_RIGHT_PORT=/dev/serial/by-path/<右前を挿したポート>
HOST_LIDAR_REAR_LEFT_PORT=/dev/serial/by-path/<左後を挿したポート>

# SO-101のサーボバス用USBアダプタ(CH343)のシリアルポート。シリアル番号がパスに入るため、機体ごとに書き換える。
HOST_ARM_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90151157-if00

# 0は未設定時のROS 2デフォルト値でもあるため、同じLAN上に他のROS 2ノード・他のdiegobot機体が
# いる場合は衝突を避けるため機体ごとに別の値にすること。
ROS_DOMAIN_ID=0

# (参考) もしプログラム側でシリアルの通信速度（ボーレート）なども変えたい場合
# APP_BAUDRATE=115200

# robot_tools(DifyのLLMからロボットの動作を呼ぶHTTP API、サーバー機で動かす)
# Difyに登録するスキーマのサーバーURL。Difyのコンテナから開発機に届く、変わらないアドレス(docker0の開発機側)にする。
ROBOT_TOOLS_PUBLIC_URL=http://172.17.0.1:8090
# 設定するとAuthorization: Bearer <この値>が必須になる(Difyのカスタムツールの認証にも同じ値を入れる)。
ROBOT_TOOLS_API_KEY=
