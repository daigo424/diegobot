# 公式のdocker/.env.exampleに上書きする値だけを書く。make dify-upがserver/dify/.envが無ければこれをコピーし、
# 起動のたびに公式の見本の同じ名前の行をserver/dify/.envの値で置き換えて、Difyが読む.envを作る(公式に無い名前は末尾に足す)。
# Difyの設定は環境変数だけで行い、composeやnginxの設定は書き換えない(ECS等へ移すときはこの一覧を引き継ぐ)。

# 80番は他のWebサーバーとぶつかりやすいため避ける。画面のURLを組み立てる設定にもポートを入れる。
EXPOSE_NGINX_PORT=8080
EXPOSE_NGINX_SSL_PORT=8443
TRIGGER_URL=http://localhost:8080
ENDPOINT_URL_TEMPLATE=http://localhost:8080/e/{hook_id}
NEXT_PUBLIC_SOCKET_URL=ws://localhost:8080

# ワークフローの複数人同時編集(collaboration)は使わないため、機能を切り、専用のwebsocketサービスも起動しない。
ENABLE_COLLABORATION_MODE=false
COMPOSE_PROFILES=${VECTOR_STORE:-weaviate},${DB_TYPE:-postgresql}

# 外へのアクセスの中継(ssrf_proxy)は内部のアドレスを既定で拒否するため、robot_tools(開発機の8090番)へ届くよう、
# Docker既定のネットワーク(docker0)の開発機側のアドレスだけを許可する(Difyのネットワークの範囲は起動し直すと変わるため使わない)。
SSRF_PROXY_ALLOW_PRIVATE_IPS=172.17.0.1/32

# ロボットの動作は終わるまで応答を返さず、探す・近づくは既定の待ち時間を超えることがあるため、
# robot_toolsが諦める時間(action_timeout)より長く待つ。
API_TOOL_DEFAULT_READ_TIMEOUT=320
